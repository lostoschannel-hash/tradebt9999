# Frontend public API origin. Do not append /api.
VITE_API_URL=

# Backend public frontend URL used in verification and reset links.
APP_BASE_URL=

# Comma-separated exact origins. Never use *.
PROTREBOT_CORS_ORIGINS=

# SMTP provider settings. Enter the real password only in the deployment secret store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=privacykais@gmail.com
SMTP_FROM_NAME=ProTreBot

# Set true only for isolated local development when you need response tokens.
PROTREBOT_EXPOSE_DEV_TOKENS=false
